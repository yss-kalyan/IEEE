class Solution {
    private boolean isAllZero(int[] arr) {
        for (int i = 0; i < 26; i++) {
            if (arr[i] != 0) return false;
        }
        return true;
    }
    public boolean checkInclusion(String s1, String s2) {
        int a=s1.length();
        int b=s2.length();
        if(a>b) return false;
        int arr[]=new int[26];
        for(int i=0;i<a;i++){
            arr[s1.charAt(i)-'a']++;
            arr[s2.charAt(i)-'a']--;
        }
        if(isAllZero(arr)) return true;
        for(int i=a;i<b;i++){
            arr[s2.charAt(i)-'a']--;
            arr[s2.charAt(i-a)-'a']++;
            if(isAllZero(arr)) return true;
        }
        return false;
    }
