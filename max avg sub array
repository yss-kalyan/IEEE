class Solution {
    public double findMaxAverage(int[] nums, int k) {
        int size=nums.length;
        int maxsum=0;
        for(int i=0;i<k;i++){
            maxsum+=nums[i];
        }
        int currsum=maxsum;
        for(int i=k;i<size;i++){
            currsum+=nums[i]-nums[i-k];
            if(currsum>maxsum){
                maxsum=currsum;
            }
        }
        return (double)maxsum/k;
    }
}
